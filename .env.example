# Copie para .env e preencha com os dados do seu projeto Supabase.
# Os valores saem do painel: Configurações > API.

# Usadas no servidor (SSR e funções).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Chave administrativa: ignora o RLS e permite criar, editar e excluir
# usuários. Nunca versione este valor nem use o prefixo VITE_ nele, que
# embutiria a chave no código enviado ao navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Embutidas no bundle do navegador durante o build. Só entra aqui o que
# pode ser público.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
